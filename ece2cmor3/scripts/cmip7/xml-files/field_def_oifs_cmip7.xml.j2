<?xml version="1.0"?>

<field_definition>
  <field_group id="all_atm_cmip7" default_value="1e20" chunking_blocksize_target="3.0">
    <field_group id="oifs_cmip7_lon_lat" grid_ref="reduced_sfc">
    </field_group>
    <field_group id="oifs_cmip7_lon_lat_time_tavg" grid_ref="reduced_sfc">
      <field  id="ugrd"                    priority="Core"     units="W m-2"              dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-u"            cmip7_compound_name="atmos.rsuscs.tavg-u-hxy-u.mon.glb"                     long_name="Surface Upwelling Clear-Sky Shortwave Radiation"                                                                                    standard_name="surface_upwelling_shortwave_flux_in_air_assuming_clear_sky"                                                                                                     modeling_realm="atmos"                           region="glb"        frequency="mon"        cmip6_table="Amon"         physical_parameter_name="rsuscs"                     >                                                                </field>
      <field  id="sltgrd"                  priority="Core"     units="kg m-2"             dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-lnd"          cmip7_compound_name="land.mrso.tavg-u-hxy-lnd.mon.glb"                      long_name="Total Soil Moisture Content"                                                                                                        standard_name="mass_content_of_water_in_soil"                                                                                                                                  modeling_realm="land"                            region="glb"        frequency="mon"        cmip6_table="Lmon"         physical_parameter_name="mrso"                       >                                                                </field>
      <field  id="clwcgrd"                 priority="High"     units="1"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-cl"           cmip7_compound_name="atmos.albisccp.tavg-u-hxy-cl.day.glb"                  long_name="ISCCP Mean Cloud Albedo"                                                                                                            standard_name="cloud_albedo"                                                                                                                                                   modeling_realm="atmos"                           region="glb"        frequency="day"        cmip6_table="CFday"        physical_parameter_name="albisccp"                   >                                                                </field>
      <field  id="aiwgrd"                  priority="High"     units="%"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-u"            cmip7_compound_name="atmos.climodis.tavg-u-hxy-u.mon.glb"                   long_name="MODIS Ice Cloud Area Percentage"                                                                                                    standard_name="modis_ice_topped_cloud_area_fraction"                                                                                                                           modeling_realm="atmos"                           region="glb"        frequency="mon"        cmip6_table="Emon"         physical_parameter_name="climodis"                   >                                                                </field>
      <field  id="ccc"                     priority="High"     units="%"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-u"            cmip7_compound_name="atmos.cltc.tavg-u-hxy-u.mon.glb"                       long_name="Convective Cloud Cover Percentage"                                                                                                  standard_name="convective_cloud_area_fraction"                                                                                                                                 modeling_realm="atmos aerosol"                   region="glb"        frequency="mon"        cmip6_table="AERmon"       physical_parameter_name="cltc"                       >                                                                </field>
      <field  id="falgrd"                  priority="High"     units="%"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-u"            cmip7_compound_name="atmos.cltcalipso.tavg-u-hxy-u.day.glb"                 long_name="CALIPSO Total Cloud Cover Percentage"                                                                                               standard_name="cloud_area_fraction"                                                                                                                                            modeling_realm="atmos"                           region="glb"        frequency="day"        cmip6_table="CFday"        physical_parameter_name="cltcalipso"                 >                                                                </field>
      <field  id="fsrgrd"                  priority="High"     units="%"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-u"            cmip7_compound_name="atmos.cltisccp.tavg-u-hxy-u.day.glb"                   long_name="ISCCP Total Cloud Cover Percentage"                                                                                                 standard_name="cloud_area_fraction"                                                                                                                                            modeling_realm="atmos"                           region="glb"        frequency="day"        cmip6_table="CFday"        physical_parameter_name="cltisccp"                   >                                                                </field>
      <field  id="ciwcgrd"                 priority="High"     units="%"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-u"            cmip7_compound_name="atmos.cltmodis.tavg-u-hxy-u.mon.30S-90S"               long_name="MODIS Total Cloud Area Percentage"                                                                                                  standard_name="modis_cloud_area_fraction"                                                                                                                                      modeling_realm="atmos"                           region="30S-90S"    frequency="mon"        cmip6_table="CFmon"        physical_parameter_name="cltmodis"                   >                                                                </field>
      <field  id="ccgrd"                   priority="High"     units="%"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-u"            cmip7_compound_name="atmos.clwmodis.tavg-u-hxy-u.mon.glb"                   long_name="MODIS Liquid Cloud Percentage"                                                                                                      standard_name="modis_liquid_topped_cloud_area_fraction"                                                                                                                        modeling_realm="atmos"                           region="glb"        frequency="mon"        cmip6_table="Emon"         physical_parameter_name="clwmodis"                   >                                                                </field>
      <field  id="flsrgrd"                 priority="High"     units="Pa"                 dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-cl"           cmip7_compound_name="atmos.pctisccp.tavg-u-hxy-cl.day.glb"                  long_name="ISCCP Mean Cloud Top Pressure"                                                                                                      standard_name="air_pressure_at_cloud_top"                                                                                                                                      modeling_realm="atmos"                           region="glb"        frequency="day"        cmip6_table="CFday"        physical_parameter_name="pctisccp"                   >                                                                </field>
      <field  id="esgrd"                   priority="High"     units="1"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-lnd"          cmip7_compound_name="land.mrsow.tavg-u-hxy-lnd.day.glb"                     long_name="Total Soil Wetness"                                                                                                                 standard_name="volume_fraction_of_condensed_water_in_soil_at_field_capacity"                                                                                                   modeling_realm="land"                            region="glb"        frequency="day"        cmip6_table="Eday"         physical_parameter_name="mrsow"                      >                                                                </field>
      <field  id="sktgrd"                  priority="High"     units="K"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-lsi"          cmip7_compound_name="land.tslsi.tavg-u-hxy-lsi.day.glb"                     long_name="Surface Temperature Where Land or Sea Ice"                                                                                          standard_name="surface_temperature"                                                                                                                                            modeling_realm="land seaIce"                     region="glb"        frequency="day"        cmip6_table="day"          physical_parameter_name="tslsi"                      >                                                                </field>
      <field  id="mn2t6grd"                priority="High"     units="kg m-2 s-1"         dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-is"           cmip7_compound_name="landIce.prra.tavg-u-hxy-is.mon.glb"                    long_name="Ice Sheet Rainfall Flux"                                                                                                            standard_name="rainfall_flux"                                                                                                                                                  modeling_realm="landIce"                         region="glb"        frequency="mon"        cmip6_table="LImon"        physical_parameter_name="prraIs"                     >                                                                </field>
      <field  id="sicgrd"                  priority="High"     units="%"                  dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-u"            cmip7_compound_name="seaIce.siconca.tavg-u-hxy-u.day.glb"                   long_name="Sea-Ice Area Percentage (Atmospheric Grid)"                                                                                         standard_name="sea_ice_area_fraction"                                                                                                                                          modeling_realm="seaIce"                          region="glb"        frequency="day"        cmip6_table="SIday"        physical_parameter_name="siconca"                    >                                                                </field>
      <field  id="tgrd"                    priority="Medium"   units="kg m-2 s-1"         dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-lnd"          cmip7_compound_name="land.esn.tavg-u-hxy-lnd.day.glb"                       long_name="Snow Evaporation"                                                                                                                   standard_name="water_evapotranspiration_flux"                                                                                                                                  modeling_realm="land"                            region="glb"        frequency="day"        cmip6_table="Eday"         physical_parameter_name="esn"                        >                                                                </field>
      <field  id="mx2t6grd"                priority="Medium"   units="W m-2"              dimensions="longitude latitude time"                     operation="average"  branding_suffix="tavg-u-hxy-lnd"          cmip7_compound_name="land.hfdsl.tavg-u-hxy-lnd.3hr.glb"                     long_name="Ground heat flux at 3hr"                                                                                                            standard_name="surface_downward_heat_flux_in_air"                                                                                                                              modeling_realm="land"                            region="glb"        frequency="3hr"        cmip6_table="3hr"          physical_parameter_name="hfdsl"                      >                                                                </field>
    </field_group>
    <field_group id="oifs_cmip7_lon_lat_plev19_time_tavg" grid_ref="reduced_plev19">
    </field_group>
    <field_group id="oifs_cmip7_lon_lat_alevel_time_tavg" grid_ref="reduced_ml">
      <field  id="ucdvgrd"                 priority="High"     units="m-3"                dimensions="longitude latitude alevel time"              operation="average"  branding_suffix="tavg-al-hxy-u"           cmip7_compound_name="aerosol.cdnc.tavg-al-hxy-u.mon.30S-90S"                long_name="Cloud Liquid Droplet Number Concentration"                                                                                          standard_name="number_concentration_of_cloud_liquid_water_particles_in_air"                                                                                                    modeling_realm="aerosol"                         region="30S-90S"    frequency="mon"        cmip6_table="AERmon"       physical_parameter_name="cdnc"                       >                                                                </field>
      <field  id="10fg6grd"                priority="High"     units="m s-1"              dimensions="longitude latitude alevel time"              operation="average"  branding_suffix="tavg-al-hxy-u"           cmip7_compound_name="aerosol.wa.tavg-al-hxy-u.mon.glb"                      long_name="Upward Air Velocity"                                                                                                                standard_name="upward_air_velocity"                                                                                                                                            modeling_realm="aerosol"                         region="glb"        frequency="mon"        cmip6_table="AERmon"       physical_parameter_name="wa"                         >                                                                </field>
    </field_group>
    <field_group id="oifs_cmip7_lon_lat_plev3_time1" grid_ref="reduced_plev3">
    </field_group>
    <field_group id="oifs_cmip7_lon_lat_time_height2m" grid_ref="reduced_sfc">
    </field_group>
    <field_group id="oifs_cmip7_lon_lat_time_height10m" grid_ref="reduced_sfc">
      <field  id="dhrgrd"                  priority="Core"     units="m s-1"              dimensions="longitude latitude time height10m"           operation="average"  branding_suffix="tavg-h10m-hxy-u"         cmip7_compound_name="atmos.sfcWind.tavg-h10m-hxy-u.day.glb"                 long_name="Near-Surface Wind Speed"                                                                                                            standard_name="wind_speed"                                                                                                                                                     modeling_realm="atmos"                           region="glb"        frequency="day"        cmip6_table="day"          physical_parameter_name="sfcWind"                    >                                                                </field>
      <field  id="dhrgrd"                  priority="High"     units="m s-1"              dimensions="longitude latitude time height10m"           operation="maximum"  branding_suffix="tmax-h10m-hxy-u"         cmip7_compound_name="atmos.sfcWind.tmax-h10m-hxy-u.day.glb"                 long_name="Daily Maximum Near-Surface Wind Speed"                                                                                              standard_name="wind_speed"                                                                                                                                                     modeling_realm="atmos"                           region="glb"        frequency="day"        cmip6_table="day"          physical_parameter_name="sfcWindmax"                 >                                                                </field>
    </field_group>
    <field_group id="oifs_cmip7_other" grid_ref="reduced_sfc">
      <field  id="qgrd"                    priority="Core"     units="m"                  dimensions="longitude latitude sdepth"                   operation="once"     branding_suffix="ti-sl-hxy-lnd"           cmip7_compound_name="land.slthick.ti-sl-hxy-lnd.fx.glb"                     long_name="Thickness of Soil Layers"                                                                                                           standard_name="cell_thickness"                                                                                                                                                 modeling_realm="land"                            region="glb"        frequency="fx"         cmip6_table="Efx"          physical_parameter_name="slthick"                    >                                                                </field>
      <field  id="alwgrd"                  priority="High"     units="%"                  dimensions="longitude latitude time p220"                operation="average"  branding_suffix="tavg-220hPa-hxy-air"     cmip7_compound_name="atmos.clcalipso.tavg-220hPa-hxy-air.day.glb"           long_name="CALIPSO High Level Cloud Area Percentage"                                                                                           standard_name="cloud_area_fraction_in_atmosphere_layer"                                                                                                                        modeling_realm="atmos"                           region="glb"        frequency="day"        cmip6_table="CFday"        physical_parameter_name="clhcalipso"                 >                                                                </field>
      <field  id="acfgrd"                  priority="High"     units="%"                  dimensions="longitude latitude time p560"                operation="average"  branding_suffix="tavg-560hPa-hxy-air"     cmip7_compound_name="atmos.clcalipso.tavg-560hPa-hxy-air.day.glb"           long_name="CALIPSO Mid Level Cloud Cover Percentage"                                                                                           standard_name="cloud_area_fraction_in_atmosphere_layer"                                                                                                                        modeling_realm="atmos"                           region="glb"        frequency="day"        cmip6_table="CFday"        physical_parameter_name="clmcalipso"                 >                                                                </field>
      <field  id="lsfgrd"                  priority="High"     units="%"                  dimensions="longitude latitude time p840"                operation="average"  branding_suffix="tavg-840hPa-hxy-air"     cmip7_compound_name="atmos.clcalipso.tavg-840hPa-hxy-air.day.glb"           long_name="CALIPSO Low Level Cloud Cover Percentage"                                                                                           standard_name="cloud_area_fraction_in_atmosphere_layer"                                                                                                                        modeling_realm="atmos"                           region="glb"        frequency="day"        cmip6_table="CFday"        physical_parameter_name="cllcalipso"                 >                                                                </field>
    </field_group>
   </field_group>
</field_definition>
