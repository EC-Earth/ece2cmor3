        <variable name="frequency" type="string">day</variable>
        <variable name="cmip6_table" type="string">AERday</variable>
        <variable name="physical_parameter_name" type="string">maxpblz</variable>
      </field>
      <field id="minpblz" field_ref="blh" unit="m" operation="minimum" long_name="Minimum PBL Height" standard_name="atmosphere_boundary_layer_thickness">
        <variable name="priority" type="string">High</variable>
        <variable name="dimensions" type="string">longitude latitude time</variable>
        <variable name="branding_label" type="string">tmin-u-hxy-u</variable>
        <variable name="cmip7_compound_name" type="string">atmos.bldep.tmin-u-hxy-u.day.glb</variable>
        <variable name="modeling_realm" type="string">atmos</variable>
        <variable name="region" type="string">glb</variable>
