        <variable name="dimensions" type="string">longitude latitude time</variable>
        <variable name="branding_label" type="string">tavg-u-hxy-u</variable>
        <variable name="cmip7_compound_name" type="string">atmosChem.drynoy.tavg-u-hxy-u.mon.glb</variable>
        <variable name="modeling_realm" type="string">atmosChem aerosol</variable>
        <variable name="region" type="string">glb</variable>
        <variable name="frequency" type="string">mon</variable>
        <variable name="cmip6_table" type="string">AERmon</variable>
        <variable name="physical_parameter_name" type="string">drynoy</variable>
      </field>
      <field id="wetnh3" unit="kg m-2 s-1" operation="average" long_name="Wet Deposition Rate of NH3" standard_name="minus_tendency_of_atmosphere_mass_content_of_ammonia_due_to_wet_deposition">
