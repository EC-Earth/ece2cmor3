<?xml version="1.0"?>

<field_definition>
  <!-- Catalog metadata use child variables; grids and files control dimensions and frequency. -->
  <field_group id="all_atm_cmip7" default_value="1e20" chunking_blocksize_target="3.0">
    <field_group id="oifs_cmip7_lon_lat" grid_ref="reduced_sfc">
    </field_group>
    <field_group id="oifs_cmip7_lon_lat_time_tavg" grid_ref="reduced_sfc">
      <field id="bldep" field_ref="blh" unit="m" operation="average" long_name="Boundary Layer Depth" standard_name="atmosphere_boundary_layer_thickness">
        <variable name="priority" type="string">High</variable>
        <variable name="dimensions" type="string">longitude latitude time</variable>
        <variable name="branding_label" type="string">tavg-u-hxy-u</variable>
        <variable name="cmip7_compound_name" type="string">atmos.bldep.tavg-u-hxy-u.mon.glb</variable>
        <variable name="modeling_realm" type="string">atmos aerosol land</variable>
        <variable name="region" type="string">glb</variable>
        <variable name="frequency" type="string">mon</variable>
        <variable name="cmip6_table" type="string">AERmon</variable>
        <variable name="physical_parameter_name" type="string">bldep</variable>
      </field>
      <field id="maxpblz" field_ref="blh" unit="m" operation="maximum" long_name="Maximum PBL Height" standard_name="atmosphere_boundary_layer_thickness">
