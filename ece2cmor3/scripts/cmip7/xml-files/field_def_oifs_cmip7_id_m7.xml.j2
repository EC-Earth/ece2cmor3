      <field id="wetnh4" unit="kg m-2 s-1" operation="average" long_name="Wet Deposition Rate of NH4" standard_name="minus_tendency_of_atmosphere_mass_content_of_ammonium_dry_aerosol_particles_due_to_wet_deposition">
