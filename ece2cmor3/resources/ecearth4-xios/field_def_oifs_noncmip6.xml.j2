<!-- Extra OpenIFS output fields that are *not* CMIP6 compliant -->

<field_definition
    default_value="1e20"
>
<field_group id="all_atm_noncmip6" chunking_blocksize_target="3.0">
    <!-- 2d fields -->

    <field
        id="surface_net_solar_radiation__rsns" name="rsns"
        field_ref="ssr"
        standard_name="surface_net_solar_radiation"
        long_name="Surface net solar radiation"
        unit="W m-2"
    >
        ssr/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="surface_net_thermal_radiation__rlns" name="rlns"
        field_ref="str"
        standard_name="surface_net_thermal_radiation"
        long_name="Surface net thermal radiation"
        unit="W m-2"
    >
        str/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="top_net_solar_radiation__rsnt" name="rsnt"
        field_ref="tsr"
        standard_name="top_net_solar_radiation"
        long_name="Top net solar radiation"
        unit="W m-2"
    >
        tsr/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="top_net_thermal_radiation__rlnt" name="rlnt"
        field_ref="ttr"
        standard_name="top_net_thermal_radiation"
        long_name="Top net thermal radiation"
        unit="W m-2"
    >
        ttr/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="top_net_solar_radiation_clearsky__rsntcs" name="rsntcs"
        field_ref="tsrc"
        standard_name="top_net_solar_radiation_clearsky"
        long_name="Top net solar radiation, clear sky"
        unit="W m-2"
    >
        tsrc/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="top_net_thermal_radiation_clearsky__rlntcs" name="rlntcs"
        field_ref="ttrc"
        standard_name="top_net_thermal_radiation_clearsky"
        long_name="Top net thermal radiation, clear sky"
        unit="W m-2"
    >
        ttrc/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="atmosphere_mass_content_of_cloud_ice_water__iwp" name="iwp"
        field_ref="tciw"
        standard_name="atmosphere_mass_content_of_cloud_ice_water"
        long_name="Ice Water Path"
    />

    <field
        id="high_cloud_area_fraction__clh" name="clh"
        field_ref="hcc"
        standard_name="high_cloud_area_fraction"
        long_name="High Cloud Cover Percentage"
        unit="%"
    >
        100*hcc
    </field>

    <field
        id="medium_cloud_area_fraction__clm" name="clm"
        field_ref="mcc"
        standard_name="medium_cloud_area_fraction"
        long_name="Medium Cloud Cover Percentage"
        unit="%"
    >
        100*mcc
    </field>

    <field
        id="low_cloud_area_fraction__cll" name="cll"
        field_ref="lcc"
        standard_name="low_cloud_area_fraction"
        long_name="Low Cloud Cover Percentage"
        unit="%"
    >
        100*lcc
    </field>

    <field
        id="forecast_albedo__alb" name="alb"
        field_ref="fal"
        standard_name="forecast_albedo"
        long_name="Forecast Albedo"
    />
    
    <field 
        id="total_runoff__rnf" name="rnf"
        field_ref="sro" 
        standard_name="total_runoff" 
        long_name="Total runoff" 
        unit="kg/m2/s" 
    >
        1000*(@sro + @ssro)/{{model_config.oifs.output.sample_rate_sec}}
    </field> 

   <field
        id="ocean_flux_of_carbon_dioxide__co2of" name="co2of"
        field_ref="co2of"
        standard_name="ocean_flux_of_carbon_dioxide"
        long_name="Ocean flux of Carbon Dioxide"
   />
  
   <field
        id="natural_biosphere_flux_of_carbon_dioxide__co2nbf" name="co2nbf"
        field_ref="co2nbf"
        standard_name="natural_biosphere_flux_of_carbon_dioxide"
        long_name="Natural biosphere flux of Carbon Dioxide"
   />

   <field
        id="fco2nat__fco2nat" name="fco2nat"
        field_ref="co2nbf"
        standard_name="fco2nat"
        long_name="fco2nat"
   />
  
   <field
        id="fco2ant__fco2ant" name="fco2ant"
        field_ref="co2apf"
        standard_name="fco2ant"
        long_name="fco2ant"
   />
  
   <field
        id="fco2npp__fco2npp" name="fco2npp"
        field_ref="co2fire"
        standard_name="fco2npp"
        long_name="fco2npp"
   />
  
   <field
        id="total_column_carbon_dioxide__tcco2" name="tcco2"
        field_ref="tcco2"
        standard_name="total_column_carbon_dioxide"
        long_name="Total column Carbon Dioxide"
   />

    <!-- Pressure level fields -->

    <field
        id="carbon_dioxide__co2_mmr" name="co2_mmr"
        field_ref="co2_pl"
        standard_name="carbon_dioxide"
        long_name="Carbon Dioxide"
        unit="kg kg-1"
    />


    <!-- Model level fields -->

    <field
        id="air_pressure__pres_ml" name="pres_ml"
        field_ref="pres"
        standard_name="air_pressure"
        long_name="pressure"
    />

    <field
        id="air_temperature__ta_ml" name="ta_ml"
        field_ref="t"
        standard_name="air_temperature"
        long_name="Air Temperature"
    />

    <field
        id="carbon_dioxide__co2_mmr_ml" name="co2_mmr_ml"
        field_ref="co2"
        standard_name="carbon_dioxide"
        long_name="Carbon Dioxide"
        unit="kg kg-1"
    >
        co2
    </field>

    <field
        id="mole_fraction_of_carbon_dioxide_in_air__co2_ml" name="co2_ml"
        field_ref="co2"
        standard_name="mole_fraction_of_carbon_dioxide_in_air"
        long_name="Mole Fraction of CO2"
        unit="mol mol-1"
    >
        co2 * 28.9644 / 44.0095
    </field>

</field_group>   <!-- close all_atm_noncmip6 group -->
</field_definition>
