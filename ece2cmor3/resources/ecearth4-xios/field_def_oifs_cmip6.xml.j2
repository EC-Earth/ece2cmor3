<!-- CMIP6 CMOR compliant variables from OpenIFS -->
<field_definition
    default_value="1e20"
>
<field_group id="all_atm_cmip6" chunking_blocksize_target="3.0">
    <!-- 2d/surface fields -->

    <field
        id="air_temperature__tas" name="tas"
        field_ref="2t"
        standard_name="air_temperature"
        long_name="Near-Surface Air Temperature"
    />

    <field id="tas_min" field_ref="mn2t" operation="minimum"/>
    <field
        id="air_temperature__tasmin" name="tasmin"
        field_ref="tas_min"
        standard_name="air_temperature"
        long_name="Daily Minimum Near-Surface Air Temperature"
        freq_op="1d"
    >
        @tas_min
    </field>

    <field id="tas_max" field_ref="mx2t" operation="maximum"/>
    <field
        id="air_temperature__tasmax" name="tasmax"
        field_ref="tas_max"
        standard_name="air_temperature"
        long_name="Daily Maximum Near-Surface Air Temperature"
        freq_op="1d"
    >
        @tas_max
    </field>

    <field
        id="dew_point_temperature__tdps" name="tdps"
        field_ref="2d"
        standard_name="dew_point_temperature"
        long_name="2m Dewpoint Temperature"
    />

    <field
        id="air_pressure_at_mean_sea_level__psl" name="psl"
        field_ref="msl"
        standard_name="air_pressure_at_mean_sea_level"
        long_name="Sea Level Pressure"
    />

    <field
        id="surface_air_pressure__ps" name="ps"
        field_ref="sp"
        standard_name="surface_air_pressure"
        long_name="Surface Air Pressure"
    />

    <field
        id="toa_incoming_shortwave_flux__rsdt" name="rsdt"
        field_ref="tisr"
        standard_name="toa_incoming_shortwave_flux"
        long_name="TOA Incident Shortwave Radiation"
        unit="W m-2"
    >
        tisr/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="toa_outgoing_shortwave_flux__rsut" name="rsut"
        field_ref="tisr"
        standard_name="toa_outgoing_shortwave_flux"
        long_name="TOA Outgoing Shortwave Radiation"
        unit="W m-2"
    >
        (tisr-tsr)/{{model_config.oifs.output.sample_rate_sec}}
    </field>
    <field
        id="toa_outgoing_shortwave_flux_assuming_clear_sky__rsutcs" name="rsutcs"
        field_ref="tisr"
        standard_name="toa_outgoing_shortwave_flux_assuming_clear_sky"
        long_name="TOA Outgoing Clear-Sky Shortwave Radiation"
        unit="W m-2"
    >
        (tisr-tsrc)/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="toa_outgoing_longwave_flux__rlut" name="rlut"
        field_ref="ttr"
        standard_name="toa_outgoing_longwave_flux"
        long_name="TOA Outgoing Longwave Radiation"
        unit="W m-2"
    >
        -ttr/{{model_config.oifs.output.sample_rate_sec}}
    </field>
    <field
        id="toa_outgoing_longwave_flux_assuming_clear_sky__rlutcs" name="rlutcs"
        field_ref="ttrc"
        standard_name="toa_outgoing_longwave_flux_assuming_clear_sky"
        long_name="TOA Outgoing Clear-Sky Longwave Radiation"
        unit="W m-2"
    >
        -ttrc/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="surface_downwelling_shortwave_flux_in_air__rsds" name="rsds"
        field_ref="ssrd"
        standard_name="surface_downwelling_shortwave_flux_in_air"
        long_name="Surface Downwelling Shortwave Radiation"
        unit="W m-2"
    >
        ssrd/{{model_config.oifs.output.sample_rate_sec}}
    </field>
    <field
        id="surface_upwelling_shortwave_flux_in_air__rsus" name="rsus"
        field_ref="ssr"
        standard_name="surface_upwelling_shortwave_flux_in_air"
        long_name="Surface Upwelling Shortwave Radiation"
        unit="W m-2"
    >
        (ssrd-ssr)/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="surface_downwelling_longwave_flux_in_air__rlds" name="rlds"
        field_ref="strd"
        standard_name="surface_downwelling_longwave_flux_in_air"
        long_name="Surface Downwelling Longwave Radiation"
        unit="W m-2"
    >
        strd/{{model_config.oifs.output.sample_rate_sec}}
    </field>
    <field
        id="surface_upwelling_longwave_flux_in_air__rlus" name="rlus"
        field_ref="str"
        standard_name="surface_upwelling_longwave_flux_in_air"
        long_name="Surface Upwelling Longwave Radiation"
        unit="W m-2"
    >
        (strd-str)/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="surface_downwelling_shortwave_flux_in_air_assuming_clear_sky__rsdscs" name="rsdscs"
        field_ref="ssrdc"
        standard_name="surface_downwelling_shortwave_flux_in_air_assuming_clear_sky"
        long_name="Surface Downwelling Clear-Sky Shortwave Radiation"
        unit="W m-2"
    >
        ssrdc/{{model_config.oifs.output.sample_rate_sec}}
    </field>
    <field
        id="surface_upwelling_shortwave_flux_in_air_assuming_clear_sky__rsuscs" name="rsuscs"
        field_ref="ssrc"
        standard_name="surface_upwelling_shortwave_flux_in_air_assuming_clear_sky"
        long_name="Surface Upwelling Clear-Sky Shortwave Radiation"
        unit="W m-2"
    >
        (ssrdc-ssrc)/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="surface_downwelling_longwave_flux_in_air_assuming_clear_sky__rldscs" name="rldscs"
        field_ref="strdc"
        standard_name="surface_downwelling_longwave_flux_in_air_assuming_clear_sky"
        long_name="Surface Downwelling Clear-Sky Longwave Radiation"
        unit="W m-2"
    >
        strdc/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field id="sfcWind_u" field_ref="10u"/>
    <field id="sfcWind_v" field_ref="10v"/>
    <field
        id="wind_speed__sfcWind" name="sfcWind"
        field_ref="sfcWind_u"
        standard_name="wind_speed"
        long_name="Near-Surface Wind Speed"
        unit="m s-1"
    >
        sqrt(sfcWind_u*sfcWind_u + sfcWind_v*sfcWind_v)
    </field>

    <field id="sfcWind_max" field_ref="wind_speed__sfcWind" operation="maximum"/>
    <field
        id="wind_speed__sfcWindmax" name="sfcWindmax"
        field_ref="sfcWind_max"
        standard_name="wind_speed"
        long_name="Daily Maximum Near-Surface Wind Speed"
        freq_op="1d"
    >
        @sfcWind_max
    </field>

    <field
        id="surface_snow_thickness__snd" name="snd"
        field_ref="sd"
        standard_name="surface_snow_thickness"
        long_name="Snow Depth"
    >
        1000.0 * @sd / @rsn
    </field>
    
    <field
        id="surface_albedo__albsn" name="albsn"
        field_ref="asn"
        standard_name="surface_albedo"
        long_name="Snow Albedo"
        detect_missing_value="true"
    >
        (sd>0.0)?asn:$missing_value
    </field>
    
    <field
        id="temperature_in_surface_snow__tempsn" name="tempsn"
        field_ref="tsn"
        standard_name="temperature_in_surface_snow"
        long_name="Snow Internal Temperature"
        detect_missing_value="true"
    >
        (sd>0.0)?tsn:$missing_value
    </field>
    
    <field
        id="surface_upward_sensible_heat_flux__hfss" name="hfss"
        field_ref="sshf"
        standard_name="surface_upward_sensible_heat_flux"
        long_name="Surface Upward Sensible Heat Flux"
        unit="W m-2"
    >
        -sshf/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="surface_upward_latent_heat_flux__hfls" name="hfls"
        field_ref="slhf"
        standard_name="surface_upward_latent_heat_flux"
        long_name="Surface Upward Latent Heat Flux"
        unit="W m-2"
    >
        -slhf/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="cloud_area_fraction__clt" name="clt"
        field_ref="tcc"
        standard_name="cloud_area_fraction"
        long_name="Total Cloud Cover Percentage"
        unit="%"
    >
        100*tcc
    </field>

    <field
        id="precipitation_flux__pr" name="pr"
        field_ref="tp"
        standard_name="precipitation_flux"
        long_name="Precipitation"
        unit="kg m-2 s-1"
    >
        1000*tp/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="snowfall_flux__prsn" name="prsn"
        field_ref="sf"
        standard_name="snowfall_flux"
        long_name="Snowfall"
        unit="kg m-2 s-1"
    >
        1000*sf/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field id="t2m" field_ref="2t"/>
    <field id="d2m" field_ref="2d"/>
    <field
        id="relative_humidity__hurs" name="hurs"
        field_ref="2t"
        standard_name="relative_humidity"
        long_name="Near-Surface Relative Humidity"
        unit="%"
    >
        100*exp(17.62*((d2m-273.15)/(d2m-30.03)-(t2m-273.15)/(t2m-30.03)))
    </field>

    <field
        id="atmosphere_mass_content_of_water_vapor__prw" name="prw"
        field_ref="tcwv"
        standard_name="atmosphere_mass_content_of_water_vapor"
        long_name="Water Vapor Path"
        unit="kg m-2"
    />

    <field
        id="atmosphere_mass_content_of_cloud_liquid_water__lwp" name="lwp"
        field_ref="tclw"
        standard_name="atmosphere_mass_content_of_cloud_liquid_water"
        long_name="Liquid Water Path"
        unit="kg m-2"
    />

    <field
        id="water_evapotranspiration_flux__evspsbl" name="evspsbl"
        field_ref="e"
        standard_name="water_evapotranspiration_flux"
        long_name="Evaporation Including Sublimation and Transpiration"
        unit="kg m-2 s-1"
    >
        -1000*e/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="surface_downward_eastward_stress__tauu" name="tauu"
        field_ref="ewss"
        standard_name="surface_downward_eastward_stress"
        long_name="Surface Downward Eastward Wind Stress"
        unit="Pa"
    >
        ewss/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="surface_downward_northward_stress__tauv" name="tauv"
        field_ref="nsss"
        standard_name="surface_downward_northward_stress"
        long_name="Surface Downward Northward Wind Stress"
        unit="Pa"
    >
        nsss/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <field
        id="magnitude_of_surface_downward_stress__tau" name="tau"
        field_ref="ewss"
        standard_name="magnitude_of_surface_downward_stress"
        long_name="Momentum Flux"
        unit="N m-2"
    >
        sqrt(ewss*ewss + nsss*nsss)/{{model_config.oifs.output.sample_rate_sec}}
    </field>

    <!-- Pressure level fields -->

    <field
        id="air_temperature__ta" name="ta"
        field_ref="t_pl"
        standard_name="air_temperature"
        long_name="Air Temperature"
    />

    <field
        id="specific_humidity__hus" name="hus"
        field_ref="q_pl"
        standard_name="specific_humidity"
        long_name="Specific Humidity"
        unit="1"
    />

    <field
        id="relative_humidity__hur" name="hur"
        field_ref="r_pl"
        standard_name="relative_humidity"
        long_name="Relative Humidity"
        unit="%"
    />

    <field
        id="eastward_wind__ua" name="ua"
        field_ref="u_pl"
        standard_name="eastward_wind"
        long_name="Eastward Wind"
    />

    <field
        id="northward_wind__va" name="va"
        field_ref="v_pl"
        standard_name="northward_wind"
        long_name="Northward Wind"
    />

    <field
        id="geopotential_height__zg" name="zg"
        field_ref="z_pl"
        standard_name="geopotential_height"
        long_name="Geopotential Height"
        unit="m"
    >
        z_pl/9.81
    </field>

    <field
        id="surface_temperature__ts" name="ts"
        field_ref="stl1"
        standard_name="surface_temperature"
        long_name="Surface Temperature"
    />

    <!-- CO2 fields -->

    <field
        id="mole_fraction_of_carbon_dioxide_in_air__co2" name="co2"
        field_ref="co2_pl"
        standard_name="mole_fraction_of_carbon_dioxide_in_air"
        long_name="Mole Fraction of CO2"
	unit="mol mol-1"
    >
        co2_pl * 28.9644 / 44.0095
    </field>

    <field
        id="mole_fraction_of_carbon_dioxide_in_air__co2s" name="co2s"
        field_ref="co2"
        standard_name="mole_fraction_of_carbon_dioxide_in_air"
        long_name="Atmosphere CO2"
        unit="ppm"
    >
        co2 * 28.9644 / 44.0095 * 1e6
    </field>

    <field
        id="atmosphere_mass_of_carbon_dioxide__co2mass" name="co2mass"
        field_ref="tcco2"
        standard_name="atmosphere_mass_of_carbon_dioxide"
        long_name="Total Atmospheric Mass of CO2"
        unit="kg m-2"
    />

</field_group>   <!-- close all_atm_cmip6 group -->
</field_definition>
